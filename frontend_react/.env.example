# Firebase Configuration for Movie Recommendation Engine
# Replace these values with your Web App config from Firebase Console:
# Firebase Console -> Project Settings -> General -> Your apps -> Web app (</>)

VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=movierecomendation.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=movierecomendation
VITE_FIREBASE_STORAGE_BUCKET=movierecomendation.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
